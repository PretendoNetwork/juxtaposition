generator client {
  provider = "prisma-client"
  output   = "../prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  Follow
  Empathy
  Reply
  LimitedFromPosting
  PostDeleted
  System
}

enum ProfilePrivacyType {
  Public
  UsersOnly
}

enum AutomodActionType {
  Blocked
  Logged
}

enum AutomodRuleType {
  Keyword
}

enum AutomodRuleMode {
  Block
  Log
}

enum ServerAccessLevel {
  Prod
  Beta
  Dev
}

/// User
model User {
  pid         Int      @id
  createdAt   DateTime @default(now()) @map("created_at")
  displayName String   @map("display_name")
  lastSeen    DateTime @map("last_seen")

  // TODO refactor bans to different table so it keeps a history
  accountStatus Int       @map("account_status")
  banReason     String?   @map("ban_reason")
  banEndsAt     DateTime? @map("ban_ends_at")
  bannedBy      Int?      @map("banned_by")

  settings            UserSetting?
  follows             UserFollow[]      @relation("follows")
  followers           UserFollow[]      @relation("followers")
  followedCommunities CommunityFollow[]

  @@map("users")
}

/// User settings
model UserSetting {
  pid  Int  @id @unique
  user User @relation(fields: [pid], references: [pid], onDelete: Cascade)

  receiveNotifications        Boolean            @map("receive_notifications")
  profilePrivacy              ProfilePrivacyType @map("profile_privacy")
  isFavouriteCommunityVisible Boolean            @map("is_favourite_community_visible")
  isCountryVisible            Boolean            @map("is_country_visible")
  isRelationshipVisible       Boolean            @map("is_relationship_visible")
  isBirthdayVisible           Boolean            @map("is_birthday_visible")
  isGameSkillVisible          Boolean            @map("is_game_skill_visible")

  notifyFollows Boolean @map("notify_follows")
  notifyEmpathy Boolean @map("notify_empathy")
  notifyReply   Boolean @map("notify_reply")

  profileComment String? @map("profile_comment")
  gameSkill      Int     @map("game_skill")

  @@map("user_settings")
}

/// User Follow
model UserFollow {
  pid          Int
  followingPid Int @map("following_pid")

  user          User @relation(name: "follows", fields: [pid], references: [pid], onDelete: Cascade)
  followingUser User @relation(name: "followers", fields: [followingPid], references: [pid], onDelete: Cascade)

  @@id([pid, followingPid])
  @@map("user_follows")
}

/// Community Follow
model CommunityFollow {
  pid         Int
  communityId String @map("community_id")

  user User @relation(fields: [pid], references: [pid], onDelete: Cascade)

  @@id([pid, communityId])
  @@map("community_follows")
}

/// Notification content
model Notification {
  id      String           @id
  type    NotificationType
  content Json /// Any extra context, dependent on type. Like users who followed

  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  notificationRecipients NotificationRecipient[]

  @@map("notifications")
}

/// Received notification
model NotificationRecipient {
  id      String  @id
  pid     Int
  hasRead Boolean @default(false) @map("has_read")

  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([pid])
  @@map("notification_recipients")
}

/// Automod logs
model AutomodLog {
  id        String            @id
  createdAt DateTime          @default(now()) @map("created_at")
  ruleId    String            @map("rule_id")
  author    Int
  action    AutomodActionType

  postContentBody String? @map("post_content_body")
  matches         Json?

  postId       String? @map("post_id")
  parentPostId String? @map("parent_post_id")
  communityId  String? @map("community_id")

  @@map("automod_logs")
}

/// Automod rules
model AutomodRule {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  title       String
  description String?
  enabled     Boolean
  type        AutomodRuleType
  mode        AutomodRuleMode

  keywordSettings AutomodRuleKeywordSetting?

  @@map("automod_rules")
}

/// Settings for the keyword AutomodRule
model AutomodRuleKeywordSetting {
  ruleId String      @id @map("rule_id")
  rule   AutomodRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  keywords String[]

  @@map("automod_rule_keyword_settings")
}

/// Endpoints for the discovery service
model DiscoveryEndpoint {
  id                String            @id
  createdAt         DateTime          @default(now()) @map("created_at")
  serverAccessLevel ServerAccessLevel @map("server_access_level")

  status  Int
  apiHost String @map("api_host")
  wupHost String @map("wup_host")
  ctrHost String @map("ctr_host")

  @@map("discovery_endpoints")
}

/// Report for a post
model Report {
  id         String   @id
  postId     String   @map("post_id")
  postAuthor Int      @map("post_author")
  createdAt  DateTime @default(now()) @map("created_at")

  reportedBy     Int    @map("reported_by")
  reportReasonId Int    @map("report_reasonId")
  reportMessage  String @map("report_message")

  resolved       Boolean   @default(false)
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     Int?      @map("resolved_by")
  moderationNote String?   @map("moderation_note")

  @@map("reports")
}

/// Audit logs entries
model AuditLogEntry {
  id        String   @id
  actor     Int
  createdAt DateTime @default(now()) @map("created_at")

  actionType String @map("action_type")
  context    String

  targetResourceId String   @map("target_resource_id")
  changedFields    String[] @map("changed_fields")

  @@map("audit_log_entries")
}
