generator client {
  provider = "prisma-client"
  output   = "../prisma"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  Follow
  LimitedFromPosting
  PostDeleted
  System
}

enum ProfilePrivacyType {
  Public
  UsersOnly
}

/// User
model User {
  pid         Int      @id
  createdAt   DateTime @default(now()) @map("created_at")
  displayName String   @map("display_name")
  lastSeen    DateTime @map("last_seen")

  // TODO refactor bans to different table so it keeps a history
  accountStatus Int       @map("account_status")
  banReason     String?   @map("ban_reason")
  banEndsAt     DateTime? @map("ban_ends_at")
  bannedBy      Int?      @map("banned_by")

  follows   UserFollow[] @relation("follows")
  followers UserFollow[] @relation("followers")
  settings  UserSetting?

  @@map("users")
}

/// User settings
model UserSetting {
  pid  Int  @id @unique
  user User @relation(fields: [pid], references: [pid], onDelete: Cascade)

  receiveNotifications        Boolean            @map("receive_notifications")
  profilePrivacy              ProfilePrivacyType @map("profile_privacy")
  isFavouriteCommunityVisible Boolean            @map("is_favouriteCommunity_visible")
  isCountryVisible            Boolean            @map("is_country_visible")
  isRelationshipVisible       Boolean            @map("is_relationship_visible")
  isBirthdayVisible           Boolean            @map("is_birthday_visible")
  isGameSkillVisible          Boolean            @map("is_game_skill_visible")

  profileComment String? @map("profile_comment")
  gameSkill      Int     @map("game_skill")

  @@map("user_settings")
}

/// User Follow
model UserFollow {
  pid          Int @id
  followingPid Int @map("following_pid")

  user          User @relation(name: "follows", fields: [pid], references: [pid], onDelete: Cascade)
  followingUser User @relation(name: "followers", fields: [followingPid], references: [pid], onDelete: Cascade)

  @@unique([pid, followingPid])
  @@map("user_follows")
}

/// Notification content
model Notification {
  id      String           @id
  type    NotificationType
  content Json /// Any extra context, dependent on type. Like users who followed

  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  notificationRecipients NotificationRecipient[]

  @@map("notifications")
}

/// Received notification
model NotificationRecipient {
  id      String  @id
  pid     Int
  hasRead Boolean @default(false) @map("has_read")

  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([pid])
  @@map("notification_recipients")
}
